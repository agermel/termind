{
  "name": "termind",
  "version": "0.1.0",
  "type": "module",
  "description": "Safe Termind terminal intelligence tools for OpenClaw orchestration. Pure data-transform tools — no side effects, no network access.",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "node --test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "openclaw": "^2026.4.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.25"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "keywords": [
    "openclaw",
    "termind",
    "terminal",
    "incident",
    "lark",
    "feishu"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "extensions": ["./index.ts"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  }
}
